# ── App ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — fine for development and early production)
DATABASE_URL=sqlite:///./seo_os.db
# PostgreSQL (swap when ready — no other code changes needed)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/seo_os

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate JWT_SECRET:   python -c "import secrets; print(secrets.token_hex(32))"
# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
ENCRYPTION_KEY=

# ── Legacy per-client secrets (single-tenant mode only) ───────────────────────
# In SaaS mode, API keys are stored per-user in the database (encrypted with ENCRYPTION_KEY)
# These are kept for backward compatibility with any existing single-tenant setup
WORDPRESS_CLIENT_EXAMPLE_KEY=
GSC_CLIENT_EXAMPLE_KEY=
GA4_CLIENT_EXAMPLE_KEY=
