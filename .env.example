# ── App ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
LOG_LEVEL=INFO

# ── Per-client secrets (add one block per client) ────────────────────────────
